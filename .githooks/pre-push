#!/bin/sh
# pre-push: nothing under docs/thinking ever reaches the public repo.
#
# docs/thinking holds his own messages, captured every session. github.com/SXM4434/free-stroke is public,
# so a push there that carries any commit touching docs/thinking is refused, history included, because a
# branch push sends every commit the remote lacks. Push a snapshot without docs/thinking instead
# (docs/CLOUD.md says how). Added 2026-09-29 after he asked whether anything already did this; nothing did.
remote_name="$1"
remote_url="$2"

case "$remote_url" in
  *SXM4434/free-stroke.git|*SXM4434/free-stroke) ;;
  *) exit 0 ;;
esac

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes=$remote_name"
  else
    range="$remote_sha..$local_sha"
  fi
  hit=$(git log --format=%h -1 $range -- docs/thinking 2>/dev/null)
  if [ -n "$hit" ]; then
    echo "pre-push: refused. $local_ref carries docs/thinking (commit $hit), and $remote_url is public." >&2
    echo "pre-push: push a snapshot without docs/thinking instead; see docs/CLOUD.md." >&2
    status=1
  fi
done
exit $status
